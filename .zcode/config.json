{
  "mcp": {
    "servers": {
      "code-index": {
        "type": "http",
        "url": "http://127.0.0.1:8011/mcp"
      }
    }
  },
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": [
                "${ZCODE_PROJECT_DIR}\\tools\\hooks\\memory_index.py"
              ],
              "statusMessage": "Память проекта",
              "timeoutMs": 10000
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": [
                "${ZCODE_PROJECT_DIR}\\tools\\hooks\\memory_reminder.py"
              ],
              "statusMessage": "Напоминание о памяти",
              "timeoutMs": 10000
            }
          ]
        }
      ]
    }
  }
}
